							"listen": "test",
							"script": {
								"exec": [
									"// Номер терминала выдаёт база (Р-81): запоминаем его для запросов с {{terminalId}}.",
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('terminalId', pm.response.json().id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
