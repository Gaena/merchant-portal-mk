								{
									"key": "entityId",
									"value": "comp-01",
									"description": "Необязателен и независим от entityType (P3-1); сравнение без учёта регистра"
								},
								{
									"key": "search",
									"value": "admin@millikart.az",
									"disabled": true,
									"description": "P3-1: подстрока без учёта регистра по performedBy, action, entityId и details; % и _ ищутся буквально"
								},
								{
									"key": "outcome",
									"value": "DENIED",
									"disabled": true,
									"description": "P3-1: SUCCESS / DENIED / UNRESOLVED; неизвестное значение = нет фильтра"
								},
								{
									"key": "from",
									"value": "2026-08-24",
									"disabled": true,
									"description": "P3-1: нижняя граница createdAt — ISO-instant или дата (весь день по UTC); мусор = нет фильтра"
								},
								{
									"key": "to",
									"value": "2026-08-24T23:59:59Z",
									"disabled": true,
									"description": "P3-1: верхняя граница createdAt — ISO-instant или дата (весь день по UTC)"
								}
							]
						},
						"description": "Retrieves audit log entries ('Who/When/What') with optional entity filters."
					},
