							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Main Terminal 1\",\n  \"login\": \"term_login_01\",\n  \"password\": \"term_pass_01\",\n  \"companyId\": \"comp-01\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
