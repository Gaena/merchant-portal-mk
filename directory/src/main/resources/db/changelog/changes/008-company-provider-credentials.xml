<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Р-93: к провайдеру ходят от имени компании, а не терминала. Логин и пароль компании — в
      companies; пароль зашифрован (AES-256-GCM, CredentialCipher), логин — открытым текстом и
      уникален. Колонки допускают пусто: у компаний, заведённых до Р-93, кредов нет, и pbl отказывает
      им до обращения к провайдеру. Обязательность — в API заведения.

      Колонки добавляет и pbl (011) под тем же преконтролем: кто стартовал первым, тот и добавил.
      Уникальность логина — только здесь: её проверяет directory, pbl логины только читает.

      Пароль терминала больше не нужен никому и удаляется; его колонку создавали и directory (003), и
      pbl (001), поэтому удаляют оба под преконтролем.
    -->
    <changeSet id="8-directory-companies-provider-credentials" author="millikart">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="companies"/>
            <not>
                <columnExists tableName="companies" columnName="provider_login"/>
            </not>
        </preConditions>
        <addColumn tableName="companies">
            <column name="provider_login" type="varchar(255)"/>
            <column name="provider_password" type="varchar(512)"/>
        </addColumn>
    </changeSet>

    <changeSet id="8-directory-companies-provider-login-unique" author="millikart">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="companies" columnName="provider_login"/>
            <not>
                <indexExists indexName="ux_companies_provider_login" tableName="companies"/>
            </not>
        </preConditions>
        <createIndex tableName="companies" indexName="ux_companies_provider_login" unique="true">
            <column name="provider_login"/>
        </createIndex>
    </changeSet>

    <changeSet id="8-directory-drop-terminal-password" author="millikart">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="terminals" columnName="password"/>
        </preConditions>
        <dropColumn tableName="terminals" columnName="password"/>
    </changeSet>

</databaseChangeLog>
