<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- P2-8 (Р-37): terminals are blocked instead of deleted, so they need a status.

         The very same column is added by pbl/005-terminal-status.xml, and that duplication is
         required rather than sloppy: `terminals` is created by whichever of the two services
         starts first (directory/003-directory-schema.xml or pbl/001-initial-schema.xml, each
         under its own precondition — P1-2). Add the column in one changelog only and the other
         service creates the table without it, then fails its own `ddl-auto: validate` on an
         entity that has `status`. Both changesets guard on the column, so the second one to run
         simply marks itself as done. -->

    <changeSet id="5-directory-terminal-status" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="terminals" columnName="status"/>
            </not>
        </preConditions>
        <!-- Every terminal that exists today is in service, so ACTIVE is the truthful backfill;
             the default also keeps rows inserted by the other service valid. -->
        <addColumn tableName="terminals">
            <column name="status" type="varchar(16)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
