<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Р-129: VÖEN компании — реквизит продавца на чеке плательщика. 10 цифр, задаёт администратор;
      пусто у компаний, заведённых без него, — тогда строки на чеке нет. Колонку добавляет и pbl (017)
      под тем же преконтролем: он читает её для чека, а порядок старта сервисов значения не имеет (P1-2).
    -->
    <changeSet id="11-directory-companies-tax-id" author="millikart">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="companies"/>
            <not>
                <columnExists tableName="companies" columnName="tax_id"/>
            </not>
        </preConditions>
        <addColumn tableName="companies">
            <column name="tax_id" type="varchar(10)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
