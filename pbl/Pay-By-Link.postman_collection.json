{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-a1b2-c3d4-e5f6a1b2c3d4",
		"name": "Pay-By-Link Service",
		"description": "A collection for the Pay-By-Link service, a microservice for generating and managing payment links.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Payment Links",
			"item": [
				{
					"name": "Create Payment Link",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"pm.collectionVariables.set(\"linkId\", jsonData.id);",
									"console.log(\"Set linkId to: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{$randomUUID}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"merchantOrderId\": \"ORDER-{{$timestamp}}\",\n  \"terminal\": 123456789,\n  \"amount\": 1500.50,\n  \"currency\": \"AZN\",\n  \"description\": \"Payment for order #{{$timestamp}}\",\n  \"customer\": {\n    \"fullName\": \"John Doe\",\n    \"email\": \"test@test.com\",\n    \"phone\": \"994509771884\"\n  },\n  \"paymentType\": \"DMS\",\n  \"usageType\": \"MULTIPLE\",\n  \"maxPayments\": 25,\n  \"metadata\": {\n    \"campaign\": \"summer_sale\",\n    \"internalId\": \"998877\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment-links",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payment-links"
							]
						},
						"description": "Creates a new payment link. The `test` script for this request automatically saves the returned `id` to the `linkId` collection variable for use in other requests."
					},
					"response": []
				},
				{
					"name": "Get Payment Link by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment-links/{{linkId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payment-links",
								"{{linkId}}"
							]
						},
						"description": "Retrieves detailed information for a specific payment link using the `linkId` variable."
					},
					"response": []
				},
				{
					"name": "Update Payment Link",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 1600.00,\n  \"description\": \"Updated payment for order #123456\",\n  \"status\": \"CANCELED\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment-links/{{linkId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payment-links",
								"{{linkId}}"
							]
						},
						"description": "Partially updates an existing payment link. Only fields provided in the request will be modified."
					},
					"response": []
				},
				{
					"name": "List Payment Links",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment-links?page=0&size=10&status=ACTIVE",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payment-links"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "terminal",
									"value": null,
									"disabled": true
								},
								{
									"key": "status",
									"value": "ACTIVE"
								}
							]
						},
						"description": "Retrieves a paginated list of payment links, with optional filters for terminal and status."
					},
					"response": []
				},
				{
					"name": "Open Payment Page (Customer Redirect)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment-links/{{linkId}}/open",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payment-links",
								"{{linkId}}",
								"open"
							]
						},
						"description": "Customer-facing endpoint that validates the link and redirects to the acquiring gateway. Does not require authentication. In Postman, you must disable automatic redirect following in Settings to see the 302 response."
					},
					"response": []
				}
			]
		},
		{
			"name": "Transactions",
			"item": [
				{
					"name": "Complete DMS Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 1500.50\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/complete",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"{{transactionId}}",
								"complete"
							]
						},
						"description": "Finalizes (captures) a previously authorized DMS transaction. You must first open a link to get a transactionId."
					},
					"response": []
				},
				{
					"name": "Refund Transaction",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 500.00,\n  \"reason\": \"Customer request\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/refund",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"{{transactionId}}",
								"refund"
							]
						},
						"description": "Initiates a refund for a successful transaction. You must first complete a DMS payment or have a successful SMS payment to get a transactionId."
					},
					"response": []
				},
				{
					"name": "Check Transaction Status (Redirect Page Check)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/transactions/{{providerOrderId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions",
								"{{providerOrderId}}",
								"status"
							]
						},
						"description": "Publicly accessible endpoint utilized by the landing Redirect Page to fetch and update payment transaction status from the provider."
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{apiToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string",
			"description": "The base URL for the Pay-By-Link service."
		},
		{
			"key": "apiToken",
			"value": "pbl-secret-token",
			"type": "string",
			"description": "The merchant's API token for authentication (JWT or test token fallback)."
		},
		{
			"key": "linkId",
			"value": "",
			"type": "string",
			"description": "The ID of a created payment link, automatically set by the 'Create Payment Link' request."
		},
		{
			"key": "transactionId",
			"value": "",
			"type": "string",
			"description": "The ID of a transaction, which you must set manually after opening a link."
		},
		{
			"key": "providerOrderId",
			"value": "",
			"type": "string",
			"description": "The order ID returned by the provider, used by the Redirect Page to check payment status."
		}
	]
}
