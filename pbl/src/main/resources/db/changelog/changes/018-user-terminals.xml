<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Р-131: терминалы сотрудника. Пишет их auth (008); pbl по ним сужает скоуп сотрудника — ссылки, операции,
      статистику. Таблица создаётся и здесь, в том же виде, что у auth и directory (012), и под тем же
      преконтролем: порядок старта сервисов значения не имеет (P1-2). Внешний ключ на users добавляет только
      auth — users здесь может ещё не быть.
    -->
    <changeSet id="18-pbl-user-terminals" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_terminals"/>
            </not>
        </preConditions>
        <createTable tableName="user_terminals">
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="terminal_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_by" type="varchar(255)"/>
            <column name="assigned_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_terminals" columnNames="user_id, terminal_id" constraintName="pk_user_terminals"/>
    </changeSet>

    <changeSet id="18-pbl-user-terminals-terminal-index" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="user_terminals" indexName="idx_user_terminals_terminal"/>
            </not>
        </preConditions>
        <createIndex tableName="user_terminals" indexName="idx_user_terminals_terminal">
            <column name="terminal_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
