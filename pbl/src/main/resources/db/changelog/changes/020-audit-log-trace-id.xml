<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Журнал аудита, этап 2: traceId запроса или прогона планировщика в записи — по нему запись журнала находит
      строки логов сервиса. Колонку добавляет любой из трёх создателей audit_logs (directory, auth, pbl) под тем же
      преконтролем: порядок старта сервисов значения не имеет (P1-2). Старые записи остаются без traceId.
    -->
    <changeSet id="20-pbl-audit-trace-id" author="millikart">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="audit_logs"/>
            <not>
                <columnExists tableName="audit_logs" columnName="trace_id"/>
            </not>
        </preConditions>
        <!-- 64 символа — потолок traceId из заголовка (TraceIdFilter). -->
        <addColumn tableName="audit_logs">
            <column name="trace_id" type="varchar(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
