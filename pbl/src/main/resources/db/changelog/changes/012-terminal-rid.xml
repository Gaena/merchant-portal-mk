<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Р-96: номер терминала у провайдера (terminal.rid) — pbl передаёт его при создании заказа
      (POST /order?terminalRid=…). Пишет directory (009) при заведении и сверке; pbl добавляет колонку
      под тем же преконтролем, потому что порядок старта сервисов значения не имеет (P1-2).
    -->
    <changeSet id="12-pbl-terminal-rid" author="millikart">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="terminals"/>
            <not>
                <columnExists tableName="terminals" columnName="terminal_rid"/>
            </not>
        </preConditions>
        <addColumn tableName="terminals">
            <column name="terminal_rid" type="varchar(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
