{
	"info": {
		"_postman_id": "b2c3d4e5-f6a1-b2c3-d4e5-f6a1b2c3d4e5",
		"name": "Auth Service",
		"description": "A collection for the Auth Service microservice, providing user authentication and role-based user management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"pm.collectionVariables.set(\"authToken\", jsonData.token);",
									"pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"console.log(\"Set authToken to: \" + jsonData.token);",
									"console.log(\"Set refreshToken to: \" + jsonData.refreshToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin@millikart.az\",\n  \"password\": \"<BOOTSTRAP_ADMIN_PASSWORD>\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticates a user and returns a signed JWT access token plus an opaque refresh token. The `test` script saves them to the `authToken` and `refreshToken` collection variables for use in subsequent requests. `expiresIn` (seconds) mirrors JWT_EXPIRATION_MS; `refreshExpiresIn` mirrors AUTH_REFRESH_TTL. If the password was set by someone else (user creation, a reset by an administrator, the bootstrap) the answer is 200 with passwordChangeRequired=true and no tokens (PCI DSS 8.3.5, Р-100): call Change Password to get a session."
					},
					"response": []
				},
				{
					"name": "Change Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"pm.collectionVariables.set(\"authToken\", jsonData.token);",
									"pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"console.log(\"Set authToken to: \" + jsonData.token);",
									"console.log(\"Set refreshToken to: \" + jsonData.refreshToken);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin@millikart.az\",\n  \"currentPassword\": \"<CURRENT_PASSWORD>\",\n  \"newPassword\": \"<NEW_PASSWORD>\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/change-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"change-password"
							]
						},
						"description": "Changes the password by the current one and signs in with the new one (PCI DSS 8.3.5, Р-100). Public, like Login: the same address limit, account lockout and status checks apply; a wrong current password is 400 and counts as a failed attempt. The new password follows the same policy as on user creation and must not repeat any of the last 4 passwords (PCI DSS 8.3.7, Р-102). Returns the same body as Login, with passwordChangeRequired=false; the other sessions of the user are revoked."
					},
					"response": []
				},
				{
					"name": "Refresh",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Rotates the refresh token: returns a new access token and a NEW refresh token in the same family; the presented one is retired. Public — no Authorization header needed. Any refusal is 401 \"Invalid refresh token\" (unknown, expired, revoked, or reused after the 10 s grace window — the last one revokes the whole family and logs REFRESH_TOKEN_REUSE). Send it twice quickly to see the grace window (both succeed); wait >10 s and send the OLD token again to see reuse detection kill the family."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"if (jsonData.token) {",
									"  pm.collectionVariables.set(\"authToken\", jsonData.token);",
									"  pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"  console.log(\"Rotated: new authToken and refreshToken saved\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Ends the session: revokes the whole refresh-token family. Always 204, even for an unknown or empty token (the endpoint is deliberately not an oracle). NOTE: the access token stays valid until it expires (24 h by default) — there is no blacklist; full revocation arrives when the access-token lifetime is shortened after the frontend learns to refresh (P1-13)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = JSON.parse(responseBody);",
									"pm.collectionVariables.set(\"userId\", jsonData.id);",
									"console.log(\"Set userId to: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"head@company.com\",\n  \"password\": \"securepassword\",\n  \"fullName\": \"Company Head User\",\n  \"role\": \"COMPANY_HEAD\",\n  \"companyId\": \"comp-01\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users"
							]
						},
						"description": "Creates a new user. Access restricted to SYSTEM_ADMIN (any company/role) and COMPANY_HEAD (own company, non-admin roles). The returned user ID is automatically saved to the `userId` collection variable."
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{userId}}"
							]
						},
						"description": "Retrieves detailed information for a specific user using the `userId` variable."
					},
					"response": []
				},
				{
					"name": "List Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users?page=0&size=20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								},
								{
									"key": "search",
									"value": "acme",
									"disabled": true,
									"description": "P3-1: подстрока без учёта регистра по username, fullName, companyId и названию компании; % и _ ищутся буквально; пустая строка = нет фильтра"
								},
								{
									"key": "role",
									"value": "COMPANY_HEAD",
									"disabled": true,
									"description": "P3-1: точное значение роли (регистр не важен); неизвестная роль = нет фильтра, не 400"
								}
							]
						},
						"description": "Retrieves one page of users (paginated since P2-1, 22.08.2026): the answer is a PagedResponse — {content, totalElements, totalPages, size, number}. page defaults to 0, size to 20, ceiling 200; out-of-range values are clamped, not rejected. Ordered by username, then id. Soft-deleted accounts are excluded from both content and totalElements. SYSTEM_ADMIN sees everyone, COMPANY_HEAD only its own company."
					},
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Updated Company Head User\",\n  \"status\": \"ACTIVE\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{userId}}"
							]
						},
						"description": "Partially updates user details. Only fields provided in the request payload will be modified."
					},
					"response": []
				},
				{
					"name": "Move User To Company (SYSTEM_ADMIN)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyId\": \"comp-01\",\n  \"role\": \"COMPANY_MANAGER\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{userId}}"
							]
						},
						"description": "Р-90: перевод пользователя в другую компанию и смена роли одним запросом. companyId меняет только SYSTEM_ADMIN; пустая строка снимает компанию — только вместе с ролью вне компании (SYSTEM_ADMIN, AUDITOR). Роль компании без компании — 400, несуществующая компания — 400, попытка руководителя — 403."
					},
					"response": []
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"{{userId}}"
							]
						},
						"description": "Performs a soft delete of a user by setting their status to DELETED."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string",
			"description": "The base URL for the Auth Service."
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string",
			"description": "The JWT token returned by the Login request, used for authentication."
		},
		{
			"key": "userId",
			"value": "",
			"type": "string",
			"description": "The ID of a created user, automatically set by the 'Create User' request."
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	]
}
