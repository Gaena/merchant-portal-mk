<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- PCI DSS 8.3.7 (Р-102): a new password may not repeat any of the last four. The current one
         lives in users.password_hash; this table keeps the three before it, BCrypt like the current,
         and nothing older. Each part has its own precondition, as in 003. -->
    <changeSet id="7-auth-password-history" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_history"/>
            </not>
        </preConditions>
        <createTable tableName="password_history">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="replaced_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="7-auth-password-history-user-index" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="password_history" indexName="idx_password_history_user"/>
            </not>
        </preConditions>
        <createIndex tableName="password_history" indexName="idx_password_history_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="7-auth-password-history-user-fk" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_password_history_user" foreignKeyTableName="password_history"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="password_history" baseColumnNames="user_id"
                                 constraintName="fk_password_history_user"
                                 referencedTableName="users" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
