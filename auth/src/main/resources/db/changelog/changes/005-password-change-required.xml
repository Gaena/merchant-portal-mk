<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- PCI DSS 8.3.5 (Р-100): a password set by someone else — on creation, on a reset by an
         administrator, by the bootstrap — is changed by its owner at the first sign-in. Accounts
         that exist already keep working: the column defaults to false. -->
    <changeSet id="5-auth-users-password-change-required" author="millikart">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="password_change_required"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="password_change_required" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
