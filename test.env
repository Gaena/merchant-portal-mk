# ─────────────────────────────────────────────────────────────────────────────
#  Merchant Portal — переменные окружения
# ─────────────────────────────────────────────────────────────────────────────
#
#  Шаблон. Скопируйте его и заполните реальными значениями:
#
#      cp .env.example .env
#      $EDITOR .env
#
#  Файл .env в .gitignore и в репозиторий не попадает. Реальных значений здесь
#  быть не должно — ни «временных», ни «для теста».
#
#  Сервисы не читают .env сами: переменные должны быть в окружении процесса.
#  При ручном запуске:
#
#      set -a; source .env; set +a
#      ./gradlew :auth:bootRun
#
#  Порядок запуска сервисов значения не имеет: миграции обложены преконтролями,
#  общие таблицы создаёт тот, кто стартовал первым.
#  Полная процедура — deployment_guide.md, раздел «Первый запуск и ротация ключа».
#
# ═════════════════════════════════════════════════════════════════════════════
#  ОБЯЗАТЕЛЬНЫЕ — без них сервис не стартует
# ═════════════════════════════════════════════════════════════════════════════

# Пароль пользователя БД. Нужен всем трём сервисам (auth, directory, pbl).
# Значения по умолчанию нет намеренно.
DB_PASSWORD=password

# Ключ подписи JWT (HS256). Нужен всем трём сервисам, и значение обязано
# СОВПАДАТЬ во всех трёх: токен выдаёт auth, а проверяют его directory и pbl.
# Разные значения = все запросы к directory и pbl отвечают 401.
#
# Сгенерировать:
#     openssl rand -base64 48
#
# Требования (проверяются на старте, JwtProvider): не пустой, не короче 32 байт.
# Ключ, лежавший в этом репозитории до 17.08.2026, отвергается по SHA-256 —
# он публичный, вернуть его не получится.
JWT_SECRET=KaaYTLZTWuzk6/dz4B/K2TtIa3aH/cklmRHxZae30zR3Bgm1+6FIxjkSbGzdjIKL

# ─── pbl: адреса окружения (P1-10) ───────────────────────────────────────────
#
# Три переменные ниже читает только pbl. Файл общий на три сервиса — лишние
# переменные auth и directory не мешают, они их просто не читают.
#
# Значений по умолчанию нет НАМЕРЕННО, и причина отличается от секретов: неверный
# адрес не роняет сервис, а ломает платежи. Сервис стартует, ссылки создаются,
# и только деньги никуда не идут. Поэтому «не задано» = «не стартует», как с
# JWT_SECRET и DB_PASSWORD. Все три проверяются на старте (UrlConfigurationCheck):
# пустое значение, не-URL, относительный путь или схема кроме http/https — отказ
# стартовать с инструкцией.

# Публичный адрес сервиса pbl — таким, каким его видят браузер плательщика и эквайер.
# Именно это значение уходит эквайеру как hppRedirectUrl при создании заказа
# (OpenLinkService) и определяет, КУДА эквайер вернёт плательщика после оплаты.
# С дефолтом http://localhost:8080/ в проде плательщик возвращался бы на localhost,
# и ни один платёж не завершался бы — без единой ошибки в логе.
# Локально:  http://localhost:8080/   (для localhost/127.0.0.1/[::1] предупреждения о HTTP нет)
# В проде:   https://ВАШ_ДОМЕН/       (не-HTTPS на любом другом хосте — WARN на старте)
# Значение используется как есть: пробел или перевод строки на конце — отказ стартовать.
PBL_BASE_URL=http://localhost:3000

# Адрес платёжного шлюза эквайера (TXPG) — страница оплаты, createEcomOrder.
# Значение выдаёт MilliKart, у тестового стенда и прода оно разное.
# Дефолт на тестовый стенд был бы хуже несостоявшегося старта: платежи ушли бы
# на тестового эквайера, ничего не списалось бы, а портал показывал бы «оплачено».
# Не-HTTPS адрес принимается, но даёт заметный WARN на старте (как и для API ниже).
# Адрес нужен всегда, включая локальный запуск: стаба провайдера больше нет
# (убран 20.08.2026), реализация одна, и локальная отладка идёт на тестовый стенд
# по адресам ниже.
PBL_PROVIDER_GATEWAY_BASE_URL=https://test.millikart.az:8083/

# Адрес e-commerce API эквайера — статус заказа, capture, возврат.
# По этому каналу уходит Basic-авторизация с логином и паролем терминала.
# Не-HTTPS адрес сервис принимает (HTTPS — на стороне MilliKart, запретом мы бы
# просто не дали работать с тем, что есть), но пишет заметный WARN на старте.
# Флага «разрешить небезопасный адрес» нет и не будет — его бы выставили один раз
# и забыли.
PBL_PROVIDER_API_BASE_URL=http://test.millikart.az:8000

# ═════════════════════════════════════════════════════════════════════════════
#  НЕОБЯЗАТЕЛЬНЫЕ — есть значения по умолчанию, годные для локального запуска
# ═════════════════════════════════════════════════════════════════════════════

# JDBC-адрес базы. Все три сервиса работают с ОДНОЙ базой.
# По умолчанию: jdbc:postgresql://localhost:5432/postgres
DB_URL=jdbc:postgresql://localhost:5432/postgres

# Пользователь БД. По умолчанию: postgres
# В проде заведите отдельного пользователя, а не суперпользователя postgres.
DB_USERNAME=postgres

# Время жизни access-токена (JWT) в миллисекундах. Выдаёт токен auth; directory и pbl
# только проверяют его, но переменная объявлена во всех трёх конфигурациях одинаково.
# По умолчанию: 900000 (15 минут, с P1-13). Фронтенд обновляет токен сам через
# POST /api/v1/auth/refresh, поэтому короткий срок пользователя не выкидывает.
# Это же — верхняя граница, сколько после выхода, блокировки или удаления
# пользователь фактически сохраняет доступ (access-токен проверяется без обращения
# к базе, чёрного списка нет). Увеличивать обратно до часов не нужно.
JWT_EXPIRATION_MS=900000

# ─── auth: refresh-токены (P1-12) ────────────────────────────────────────────
#
# Логин выдаёт пару: access-токен (JWT, срок выше) и refresh-токен — непрозрачную
# случайную строку, по которой POST /api/v1/auth/refresh выдаёт новую пару.
# Каждое обновление заменяет refresh-токен (ротация); повторное использование
# уже заменённого токена за пределами окна снисхождения считается кражей и гасит
# всю цепочку. Значения по умолчанию рабочие, менять не требуется.

# Срок жизни refresh-токена (ISO-8601). По умолчанию: P30D (30 дней)
AUTH_REFRESH_TTL=P30D

# Окно снисхождения после ротации: повтор того же токена в этом окне — это гонка
# двух вкладок, а не кража; запрос обслуживается. По умолчанию: PT10S (10 секунд)
AUTH_REFRESH_ROTATION_GRACE=PT10S

# Плановое удаление просроченных записей из refresh_tokens.
# По умолчанию: включено, каждый день в 03:30.
AUTH_REFRESH_CLEANUP_ENABLED=true
AUTH_REFRESH_CLEANUP_CRON="0 30 3 * * *"

# ─── Адрес клиента: доверенные прокси (P3-Auth, P2-10) ───────────────────────
#
# Читают auth (лимит попыток входа) и pbl (transactions.client_ip). Список
# адресов через запятую — это те, чьим заголовкам X-Real-IP / X-Forwarded-For
# сервис верит. Запрос, пришедший НЕ с одного из них, считается по адресу пира,
# а его заголовки игнорируются целиком: их подставляет кто угодно.
#
# По умолчанию: 127.0.0.1,::1 — это и есть вся наша схема, один nginx на той же
# машине. Расширять список, только если реально появится второй прокси: каждый
# адрес в нём — это адрес, которому разрешено назвать любого клиента.
# Пустое значение = заголовкам не верим никогда (годится, если прокси нет вовсе).
TRUSTED_PROXIES=127.0.0.1,::1

# ─── auth: лимит попыток входа по IP (P3-Auth) ───────────────────────────────
#
# Считаются ТОЛЬКО неудачные попытки, успешный вход обнуляет счётчик адреса.
# Превышение — HTTP 429 с заголовком Retry-After, до обращения к базе и до
# проверки пароля. Счётчики живут в памяти сервиса (Р-27): перезапуск auth их
# обнуляет — это осознанный размен, запись в базу на каждую неудачную попытку
# сама стала бы вектором нагрузки.
#
# Блокировка аккаунта (6 попыток / 30 минут, PCI-DSS 8.3.4) остаётся как была
# и этими переменными не управляется.
#
# ВАЖНО про общий внешний IP. Лимит считается на адрес, а не на пользователя.
# Если несколько мерчантов работают из одного офиса — для сервиса это один
# адрес, и десять неудачных попыток они выбирают вскладчину: пятеро человек по
# два раза ошиблись паролем, и вход закрыт всему офису на 15 минут. Успешный
# вход любого из них счётчик обнуляет, поэтому в обычный день это не срабатывает,
# но если такие жалобы появятся — поднимайте LOGIN_RATE_LIMIT_MAX_FAILURES
# (30–50 на большой офис), а не выключайте механизм.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_FAILURES=10
LOGIN_RATE_LIMIT_WINDOW=PT15M

# ─── auth: разовое создание первого администратора ───────────────────────────
#
# Миграция админа больше не заводит. Первый SYSTEM_ADMIN создаётся один раз,
# на пустой таблице users, при AUTH_BOOTSTRAP_ENABLED=true. После первого
# успешного старта флаг нужно вернуть в false, а пароль убрать из окружения.
#
# По умолчанию: false
AUTH_BOOTSTRAP_ENABLED=true

# Логин администратора. Обязан быть email — логин иначе его не примет.
BOOTSTRAP_ADMIN_USERNAME=admin@millikart.az

# Пароль администратора. Та же политика, что и у обычных пользователей
# (PCI-DSS v4.0): минимум 12 символов, заглавная, строчная, цифра и спецсимвол.
# Слабый пароль = сервис не стартует.
BOOTSTRAP_ADMIN_PASSWORD=Admin20260820!

# ─── pbl: статический токен-заглушка ─────────────────────────────────────────
#
# PBL_API_TOKEN даёт роль SYSTEM_ADMIN без пароля и без срока годности.
# Держите выключенным: обычный вход — через JWT.
# Включённый флаг с пустым токеном роняет старт (JwtAuthFilter).
#
# По умолчанию: false
PBL_API_TOKEN_ENABLED=false
# Заполнять, только если включаете флаг:  openssl rand -base64 32
PBL_API_TOKEN=

# ─── actuator: порт служебных эндпоинтов ─────────────────────────────────────
#
# /actuator/health, /info и /metrics вынесены с рабочего порта на отдельный,
# привязанный к 127.0.0.1. Снаружи сервера они недоступны физически — токеном
# они не защищены и защищены быть не могут: пробы мониторинга токена не имеют.
# На рабочем порту (8080/8081/8082) путь /actuator/** отдаёт 404.
#
# Значения по умолчанию заданы в yaml каждого сервиса и разные:
#     auth 9081, directory 9082, pbl 9080
#
# Поэтому в общий .env эту переменную класть НЕ нужно — одно значение на всех
# посадило бы три сервиса на один порт. Переопределяйте только при конфликте
# портов и только в окружении конкретного сервиса.
# MANAGEMENT_PORT=9081

# ─── Swagger / OpenAPI ───────────────────────────────────────────────────────
#
# /v3/api-docs — полная карта API, /swagger-ui.html — интерактивная оболочка
# к ней. В постоянной эксплуатации выключены: при false springdoc не регистрирует
# эти эндпоинты вовсе (404), и Spring Security не создаёт для них разрешающих
# правил.
#
# Включать на время приёмо-сдаточных испытаний (Swagger заявлен в
# technical_handover.md как передаваемая документация), потом вернуть в false.
# Процедура — deployment_guide.md, раздел 14.3.
#
# По умолчанию: false. Один флаг на все три сервиса и на обе части (api-docs + ui).
SWAGGER_ENABLED=false

# ─── pbl: срок жизни платёжной ссылки ────────────────────────────────────────
#
# Оба значения — длительности в формате ISO-8601 (PT24H = 24 часа, P90D = 90 дней).
# Значения по умолчанию рабочие, менять не требуется.

# Срок жизни ссылки, если мерчант не передал expiresAt при создании.
# По умолчанию: PT24H (24 часа) — ровно тот отсчёт, который показывает интерфейс.
PBL_LINK_DEFAULT_TTL=PT24H

# Потолок срока жизни. Дальше этого от МОМЕНТА СОЗДАНИЯ ссылки срок выставить
# нельзя — ни при создании, ни последующими PATCH'ами (иначе потолок можно было бы
# сдвигать бесконечно, продлевая ссылку каждый раз ещё на 90 дней). Попытка выйти
# за него — 400 с указанием предельной даты.
# По умолчанию: P90D (90 дней)
PBL_LINK_MAX_TTL=P90D

# ─── pbl: пути API эквайера ──────────────────────────────────────────────────
#
# Это константы протокола TXPG, а не адреса окружения, поэтому дефолты у них
# есть и менять их не требуется. Хост задаётся отдельно —
# PBL_PROVIDER_GATEWAY_BASE_URL / PBL_PROVIDER_API_BASE_URL в обязательных.
# {orderId} подставляет сам клиент (TxpgAcquiringClient).
PBL_PROVIDER_CREATE_ORDER_PATH=/order
PBL_PROVIDER_EXEC_TRAN_PATH=/order/{orderId}/exec-tran
PBL_PROVIDER_GET_ORDER_PATH=/order/{orderId}

# ─── pbl: фоновая сверка зависших PENDING ────────────────────────────────────
# Значения по умолчанию рабочие, менять не требуется.
PBL_RECONCILIATION_ENABLED=true
PBL_RECONCILIATION_CRON="0 */2 * * * *"
PBL_RECONCILIATION_MIN_AGE=PT2M
PBL_RECONCILIATION_MAX_AGE=PT24H
# Верхняя граница выборки: PENDING старше этого возраста сверка больше не опрашивает (P1-8a).
# Незнакомый или «чужой» финальный статус эквайера в FAILED не переводится, поэтому без
# границы такие записи заняли бы весь батч навсегда. Их количество пишется в лог каждого прогона —
# это ручные случаи.
PBL_RECONCILIATION_GIVE_UP_AGE=P7D
PBL_RECONCILIATION_BATCH_SIZE=50

# --- Чтение схемы шлюза (ecom) ---
# Отдельная учётка, только на чтение и только по нужным объектам. Без значений по умолчанию:
# сервис не должен подниматься, молча целясь в localhost, — это чужая база.
# На проде здесь обязан стоять адрес читающей реплики, а не боевого шлюза: отчётный запрос
# по операционной базе конкурирует с авторизациями.
ECOM_TXPG_URL=jdbc:oracle:thin:@localhost:1521:FREE
ECOM_TXPG_USERNAME=system
ECOM_TXPG_PASSWORD=Oracle123
ECOM_TXPG_SCHEMA=TXPG
