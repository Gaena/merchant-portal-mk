# Шаблон локального окружения (P3-3). Скопировать в .env и заполнить; .env игнорируется git.
# Полный перечень переменных с пояснениями и умолчаниями — project_docs/deployment_guide.md.
# РЕАЛЬНЫХ ЗНАЧЕНИЙ В ЭТОМ ФАЙЛЕ БЫТЬ НЕ ДОЛЖНО.

# --- База данных (общая для четырёх сервисов) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT: один и тот же секрет у auth, directory, pbl и ecom, иначе токены не пройдут проверку ---
JWT_SECRET=

# --- Первый администратор (включать на один запуск auth на пустой БД, потом выключить) ---
AUTH_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Эквайринг TXPG (pbl) ---
PBL_PROVIDER_API_BASE_URL=
PBL_PROVIDER_GATEWAY_BASE_URL=
PBL_BASE_URL=

# --- Чтение схемы шлюза (ecom) ---
# Отдельная учётка, только на чтение и только по нужным объектам. Без значений по умолчанию:
# сервис не должен подниматься, молча целясь в localhost, — это чужая база.
# На проде здесь обязан стоять адрес читающей реплики, а не боевого шлюза: отчётный запрос
# по операционной базе конкурирует с авторизациями.
ECOM_TXPG_URL=
ECOM_TXPG_USERNAME=
ECOM_TXPG_PASSWORD=
ECOM_TXPG_SCHEMA=TXPG
