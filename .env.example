# Шаблон локального окружения (P3-3). Скопировать в .env и заполнить; .env игнорируется git.
# Полный перечень переменных с пояснениями и умолчаниями — deployment_guide.md.
# РЕАЛЬНЫХ ЗНАЧЕНИЙ В ЭТОМ ФАЙЛЕ БЫТЬ НЕ ДОЛЖНО.

# --- База данных (общая для трёх сервисов) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT: один и тот же секрет у auth, directory и pbl, иначе токены не пройдут проверку ---
JWT_SECRET=

# --- Первый администратор (включать на один запуск auth на пустой БД, потом выключить) ---
AUTH_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Эквайринг TXPG (pbl) ---
PBL_PROVIDER_API_BASE_URL=
PBL_PROVIDER_GATEWAY_BASE_URL=
PBL_BASE_URL=
