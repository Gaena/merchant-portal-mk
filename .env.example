# Шаблон локального окружения (P3-3). Скопировать в .env и заполнить; .env игнорируется git.
# Полный перечень переменных с пояснениями и умолчаниями — project_docs/guides/deployment_guide.md §20.1.
# РЕАЛЬНЫХ ЗНАЧЕНИЙ В ЭТОМ ФАЙЛЕ БЫТЬ НЕ ДОЛЖНО.

# --- База данных (общая для четырёх сервисов) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT: один и тот же секрет у auth, directory, pbl и ecom, иначе токены не пройдут проверку ---
JWT_SECRET=

# --- Ключ AES-256 паролей компаний к провайдеру: одно значение у directory, pbl и ecom (openssl rand -base64 32).
# Новый ключ делает сохранённые пароли нечитаемыми — их придётся ввести заново ---
CREDENTIALS_ENCRYPTION_KEY=

# --- Первый администратор (включать на один запуск auth на пустой БД, потом выключить) ---
AUTH_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Эквайринг TXPG: адреса провайдера — одни на pbl и ecom; PBL_BASE_URL — только pbl ---
PROVIDER_API_BASE_URL=
PROVIDER_GATEWAY_BASE_URL=
PBL_BASE_URL=

# --- Чек плательщика (pbl): название и VÖEN платёжного провайдера, закон о платёжных услугах, ст. 17.1.1 ---
# Без значений по умолчанию: чек без них закону не соответствует. VÖEN — ровно 10 цифр. Значения даёт заказчик.
RECEIPT_PROVIDER_NAME=
RECEIPT_PROVIDER_TAX_ID=

# --- Чтение схемы шлюза (ecom) ---
# Отдельная учётка, только на чтение и только по нужным объектам. Без значений по умолчанию:
# сервис не должен подниматься, молча целясь в localhost, — это чужая база.
# На проде здесь обязан стоять адрес читающей реплики, а не боевого шлюза: отчётный запрос
# по операционной базе конкурирует с авторизациями.
ECOM_TXPG_URL=
ECOM_TXPG_USERNAME=
ECOM_TXPG_PASSWORD=
ECOM_TXPG_SCHEMA=TXPG
# Пояс, в котором база шлюза хранит даты (местное время без пояса).
ECOM_TXPG_ZONE=Asia/Baku
